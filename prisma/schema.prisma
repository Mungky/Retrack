// =============================================================================
// Prisma Schema — Referensi struktur database (public.users)
// =============================================================================
// Projek ini menggunakan Supabase. Migrasi aktual: supabase/migrations/
// File ini untuk dokumentasi/referensi bila Prisma akan ditambahkan nanti.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id
  email             String?
  raw_user_meta_data Json?
  isPro             Boolean  @default(false) @map("is_pro")

  @@map("users")
}
